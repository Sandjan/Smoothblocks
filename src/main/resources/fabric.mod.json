{
  "schemaVersion": 1,
  "id": "smoothblocks",
  "version": "${version}",
  "name": "Smooth Blocks",
  "description": "Two-stage xBRZ reconstruction for world terrain, entities and items, with optional Iris shaders. GUI rendering remains unchanged.",
  "environment": "client",
  "entrypoints": {
    "client": [
      "de.oai.smoothblocks.SmoothBlocksClientEntrypoint"
    ]
  },
  "license": "GPL-3.0-or-later",
  "authors": [
    "SmoothBlocks contributors"
  ],
  "mixins": [
    {
      "config": "smoothblocks.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "26.1.2",
    "java": ">=25",
    "sodium": ">=0.9.1"
  }
}
